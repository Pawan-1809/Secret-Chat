# Files and directories to ignore during Vercel deployment

# Development files
.replit
replit.md
.local/

# Environment files (use Vercel dashboard for env vars)
.env
.env.local
.env.development
.env.test

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts (except dist/public which is needed)
.next/
.nuxt/
.vuepress/dist/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Temporary folders
tmp/
temp/
